{
  "cli": {
    "version": ">= 16.0.1",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "productionSourceMap": false,
    "appVersionSource": "remote"
  },
  "build": {
    "cache": {
      "paths": ["node_modules/.cache", "~/.gradle/caches", "~/.cocoapods"]
    },
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "autoIncrement": true,
      "android": {
        "buildType": "apk"
      }
    },
    "device": {
      "developmentClient": false,
      "distribution": "internal",
      "environment": "preview",
      "channel": "device",
      "autoIncrement": true,
      "env": {
        "EAS_USE_CACHE": "1",
        "EXPO_PUBLIC_APP_ENV": "preview",
        "EXPO_PUBLIC_TRAVEL_SHARE_BASE_URL": "https://ontrack--links.expo.app"
      },
      "ios": {
        "buildConfiguration": "Release",
        "resourceClass": "m-medium"
      }
    },
    "testflight": {
      "developmentClient": false,
      "distribution": "store",
      "environment": "preview",
      "channel": "testflight",
      "autoIncrement": true,
      "autoSubmit": true,
      "env": {
        "EAS_USE_CACHE": "1",
        "EXPO_PUBLIC_APP_ENV": "testflight",
        "EXPO_PUBLIC_TRAVEL_SHARE_BASE_URL": "https://ontrack--links.expo.app"
      },
      "ios": {
        "buildConfiguration": "Release",
        "resourceClass": "m-large"
      }
    },
    "production": {
      "environment": "production",
      "channel": "production",
      "autoIncrement": true,
      "env": {
        "EAS_USE_CACHE": "1",
        "EXPO_PUBLIC_TRAVEL_SHARE_BASE_URL": "https://ontrack--links.expo.app"
      },
      "ios": {
        "resourceClass": "m-medium"
      }
    }
  },
  "submit": {
    "testflight": {
      "ios": {
        "ascAppId": "6789723522"
      }
    },
    "production": {
      "ios": {
        "ascAppId": "6789723522"
      }
    }
  }
}
