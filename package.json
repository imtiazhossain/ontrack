  "devDependencies": {
    "@react-native/jest-preset": "^0.86.2",
    "@types/jest": "29.5.14",
    "@types/node": "^26.1.1",
    "@types/react": "~19.2.2",
    "eslint": "^9.0.0",
    "eslint-config-expo": "~57.0.1",
    "jest": "~29.7.0",
    "jest-expo": "~57.0.3",
    "typescript": "~6.0.3"
  },
  "engines": {
    "node": ">=20 <25"
  },
  "scripts": {
    "start": "node ./scripts/assert-node.js && expo start --dev-client",
    "start:clear": "node ./scripts/assert-node.js && expo start --dev-client --clear",
    "reset-project": "node ./scripts/reset-project.js",
    "android": "node ./scripts/assert-node.js && expo start --dev-client --android",
    "ios": "node ./scripts/assert-node.js && expo start --dev-client --ios",
    "web": "node ./scripts/assert-node.js && expo start --web",
    "lint": "expo lint",
    "test": "jest",
    "typecheck": "tsc --noEmit",
    "update:testflight": "npx eas-cli@latest update --channel testflight --environment preview",
    "update:production": "npx eas-cli@latest update --channel production --environment production",
    "ios:ensure-codesign": "bash ./scripts/ensure-ios-simulator-codesign.sh",
    "ios:resign-sim": "node ./scripts/resign-ios-simulator-app.js",
    "ios:run": "bash ./scripts/ensure-ios-simulator-codesign.sh && expo run:ios",
    "build:testflight": "npm run optimize && npx eas-cli@latest build --platform ios --profile testflight --non-interactive --auto-submit",
    "packager:ensure": "bash ./scripts/ensure-packager.sh",
    "packager:ensure:start": "bash ./scripts/ensure-packager.sh --start"
  },
  "jest": {
    "preset": "jest-expo",
    "testMatch": [
      "**/__tests__/**/*.test.ts"
    ]
  },
  "private": true
}
