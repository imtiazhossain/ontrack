{
  "expo": {
    "name": "onTrack",
    "slug": "onTrack",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "ontrack",
    "userInterfaceStyle": "automatic",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/bd232bf6-7397-4463-b25a-9b67d78e5695"
    },
    "ios": {
      "icon": "./assets/expo.icon",
      "bundleIdentifier": "com.imtihoss.ontracknow",
      "usesAppleSignIn": true,
      "supportsTablet": false,
      "associatedDomains": [
        "applinks:ontrack--links.expo.app"
      ],
      "infoPlist": {
        "NSCameraUsageDescription": "onTrack uses the camera to capture meal, activity, plant-care, and vision-board photos.",
        "NSPhotoLibraryUsageDescription": "onTrack accesses your photo library so you can attach meal, activity, plant-care, and vision-board photos.",
        "ITSAppUsesNonExemptEncryption": false
      },
      "appleTeamId": "F5HRXF5795"
    },
    "android": {
      "package": "com.imtihoss.ontracknow",
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "ontrack--links.expo.app",
              "pathPrefix": "/l/"
            },
            {
              "scheme": "https",
              "host": "ontrack--links.expo.app",
              "pathPrefix": "/i/"
            },
            {
              "scheme": "https",
              "host": "ontrack--links.expo.app",
              "pathPrefix": "/c/"
            },
            {
              "scheme": "https",
              "host": "ontrack--links.expo.app",
              "pathPrefix": "/f/"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ],
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ]
    },
    "web": {
      "output": "server",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      [
        "expo-router",
        {
          "headers": {
            "Cache-Control": "public, max-age=0, s-maxage=300, stale-while-revalidate=3600, stale-if-error=86400"
          }
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "onTrack accesses your photos so you can attach meal, activity, plant-care, and vision-board photos.",
          "cameraPermission": "onTrack uses the camera to capture meal, activity, plant-care, and vision-board photos.",
          "microphonePermission": false
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#208AEF",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ],
      "expo-image",
      "expo-status-bar",
      "expo-web-browser",
      "expo-apple-authentication",
      "expo-secure-store",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "onTrack uses your approximate location to suggest a departure city for travel searches."
        }
      ],
      [
        "expo-notifications",
        {
          "defaultChannel": "event-chat"
        }
      ],
      "./plugins/with-simulator-keychain-codesign.js",
      [
        "expo-sharing",
        {
          "ios": {
            "enabled": true,
            "activationRule": {
              "supportsText": true,
              "supportsWebUrlWithMaxCount": 1,
              "supportsWebPageWithMaxCount": 1,
              "supportsImageWithMaxCount": 1,
              "supportsFileWithMaxCount": 1
            }
          },
          "android": {
            "enabled": true,
            "singleShareMimeTypes": [
              "text/plain",
              "text/uri-list",
              "text/calendar",
              "application/ics",
              "image/*"
            ]
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": false
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "bd232bf6-7397-4463-b25a-9b67d78e5695"
      }
    },
    "owner": "imtihoss"
  }
}
